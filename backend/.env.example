# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Connection string from the MongoDB Atlas dashboard.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# The database name for this environment (e.g. make-my-marriage-dev, make-my-marriage-prod).
DATABASE_NAME=make-my-marriage-dev

# ─── Security ──────────────────────────────────────────────────────────────────
# Secret key used for signing session tokens. Use a long, random value in production.
SECRET_KEY=change-me-to-a-long-random-secret

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In local development this is the Next.js dev server.
CORS_ORIGINS=http://localhost:3000

# ─── Email Service (Resend) ────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Verified sender domain or Resend sandbox address
EMAIL_FROM="Make My Marriage <onboarding@resend.dev>"
# Base frontend URL for invitation & RSVP links
FRONTEND_URL=http://localhost:3000
