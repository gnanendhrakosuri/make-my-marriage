<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <!-- 3D Gold Shading Gradients -->
    <linearGradient id="goldTube" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE885"/>
      <stop offset="25%" stop-color="#F3C32C"/>
      <stop offset="60%" stop-color="#D69B12"/>
      <stop offset="85%" stop-color="#A56E05"/>
      <stop offset="100%" stop-color="#FCDD6A"/>
    </linearGradient>

    <linearGradient id="goldHighlight" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FCEBA0"/>
      <stop offset="50%" stop-color="#D99E10"/>
      <stop offset="100%" stop-color="#FFF8D4"/>
    </linearGradient>

    <!-- Blue Diamond Facet Gradients -->
    <linearGradient id="diamondTable" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3A8DFF"/>
      <stop offset="50%" stop-color="#1E65D6"/>
      <stop offset="100%" stop-color="#103E99"/>
    </linearGradient>

    <linearGradient id="diamondFacetLight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#80CEFF"/>
      <stop offset="100%" stop-color="#3598F5"/>
    </linearGradient>

    <linearGradient id="diamondFacetDark" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1A51B0"/>
      <stop offset="100%" stop-color="#0A2863"/>
    </linearGradient>
  </defs>

  <!-- Left Wedding Ring (Background / Interlocked) -->
  <g id="leftRing">
    <!-- Back outer body -->
    <ellipse cx="37" cy="59" rx="27" ry="25" fill="none" stroke="url(#goldTube)" stroke-width="8.5"/>
    <!-- Inner rim sheen -->
    <ellipse cx="37" cy="59" rx="24" ry="22.2" fill="none" stroke="#FFF2B8" stroke-width="1.2" opacity="0.65"/>
  </g>

  <!-- Right Wedding Ring with Blue Diamond -->
  <g id="rightRing">
    <!-- Main Right Band -->
    <ellipse cx="64" cy="55" rx="28" ry="26" fill="none" stroke="url(#goldHighlight)" stroke-width="8.5"/>
    <ellipse cx="64" cy="55" rx="25" ry="23" fill="none" stroke="#FFEFA3" stroke-width="1.2" opacity="0.7"/>

    <!-- Left Ring Interlocking Overlap Arc -->
    <!-- Clips and redraws front part of left ring to look organically interlocked -->
    <path d="M 23 45 A 27 25 0 0 1 50 41" fill="none" stroke="url(#goldTube)" stroke-width="8.5"/>
    <path d="M 25 46 A 24 22.2 0 0 1 48 43" fill="none" stroke="#FFF2B8" stroke-width="1.2" opacity="0.65"/>

    <!-- Gold Bezel / Diamond Collet Setting -->
    <polygon points="58,25 70,25 68,29 60,29" fill="#F8C72B" stroke="#B87D09" stroke-width="0.8"/>

    <!-- Faceted Blue Brilliant Diamond -->
    <!-- Top Table -->
    <polygon points="56,7 72,7 80,12 48,12" fill="url(#diamondTable)"/>
    <!-- Center Table Glint -->
    <polygon points="58,8 70,8 74,11 54,11" fill="#4AA3FF" opacity="0.8"/>

    <!-- Lower Pavilion Facets -->
    <polygon points="48,12 58,25 64,12" fill="url(#diamondFacetDark)"/>
    <polygon points="64,12 58,25 70,25 64,12" fill="url(#diamondFacetLight)"/>
    <polygon points="64,12 70,25 80,12" fill="url(#diamondTable)"/>

    <!-- Corner reflections -->
    <polygon points="48,12 54,12 52,19" fill="#A8E0FF" opacity="0.7"/>
    <polygon points="76,12 80,12 73,19" fill="#1C5AB8"/>
  </g>
</svg>
