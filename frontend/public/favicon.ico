<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <defs>
    <!-- Rich 24K Polished Gold Gradient -->
    <linearGradient id="ringGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE49E"/>
      <stop offset="35%" stop-color="#D4AF37"/>
      <stop offset="70%" stop-color="#AA7C11"/>
      <stop offset="100%" stop-color="#E5C77A"/>
    </linearGradient>

    <!-- Diamond Brilliant Gradient -->
    <linearGradient id="diamondShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="50%" stop-color="#E8F4FD"/>
      <stop offset="100%" stop-color="#BEE3F8"/>
    </linearGradient>

    <!-- Subtle Drop Shadow -->
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1" stdDeviation="1" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <g filter="url(#shadow)">
    <!-- Main Wedding Band Ring -->
    <circle cx="16" cy="18" r="9" fill="none" stroke="url(#ringGold)" stroke-width="3.5" stroke-linecap="round"/>

    <!-- Inner Golden Highlight Accent -->
    <circle cx="16" cy="18" r="7.4" fill="none" stroke="#FFE9A8" stroke-width="0.8" opacity="0.6"/>

    <!-- Prongs Setting Crown -->
    <path d="M 13.5 10.5 L 14.5 7 L 17.5 7 L 18.5 10.5" fill="none" stroke="url(#ringGold)" stroke-width="1.2"/>

    <!-- Prominent Brilliant-Cut Diamond Facets -->
    <!-- Table & Crown -->
    <polygon points="13.5,6.5 18.5,6.5 21,9 11,9" fill="url(#diamondShine)"/>
    <!-- Pavilion & Culet -->
    <polygon points="11,9 21,9 16,14.5" fill="url(#diamondShine)" opacity="0.95"/>
    <!-- Center Facet Reflection Line -->
    <polygon points="14.5,6.5 17.5,6.5 17,9 15,9" fill="#FFFFFF"/>
    <polygon points="15,9 17,9 16,14.5" fill="#EBF8FF"/>

    <!-- Sparkling Diamond Star Glow -->
    <circle cx="13.5" cy="7.5" r="0.75" fill="#FFFFFF"/>
  </g>
</svg>
